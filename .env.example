# Copy to .env.local and fill in. Never commit .env.local.

# --- Clerk (dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Clerk → Webhooks → endpoint signing secret (whsec_...). Endpoint: /api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/today

# --- Supabase (local: `pnpm db:start` prints these; prod: Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# Server-only. Used by the Clerk webhook + first-login bootstrap. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Local Supabase ↔ Clerk third-party auth (read by supabase/config.toml) ---
# Your Clerk Frontend API domain, e.g. happy-cat-12.clerk.accounts.dev (no https://)
CLERK_FRONTEND_API_DOMAIN=xxx.clerk.accounts.dev
